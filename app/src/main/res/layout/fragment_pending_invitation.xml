<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl"
    android:background="@color/sc_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/list_back"
                style="@style/Widget.SmartCart.Button.Secondary" android:layout_width="36dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="@string/sc_screen_chevron" android:textDirection="ltr"
                android:textSize="26sp" android:contentDescription="@string/list_back" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SmartCart.Headline" android:text="@string/invitation_title" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/sc_line" />
    <TextView android:id="@+id/invitation_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="44dp" android:textAppearance="@style/TextAppearance.SmartCart.TitleLarge" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/invitation_details"
        style="@style/Widget.SmartCart.Card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:visibility="gone">
    <TextView android:id="@+id/invitation_description" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="0dp" android:textAppearance="@style/TextAppearance.SmartCart.Body" />
    </com.google.android.material.card.MaterialCardView>
    <TextView android:id="@+id/invitation_benefits" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="44dp" android:textAppearance="@style/TextAppearance.SmartCart.Body" />
    <com.google.android.material.button.MaterialButton android:id="@+id/invitation_accept"
        style="@style/Widget.SmartCart.Button.Primary" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="56dp" android:text="@string/invitation_accept" />
    <com.google.android.material.button.MaterialButton android:id="@+id/invitation_decline"
        style="@style/Widget.SmartCart.Button.Secondary" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="8dp" android:backgroundTint="@color/sc_surface" android:text="@string/invitation_decline" />
    </LinearLayout>
</ScrollView>

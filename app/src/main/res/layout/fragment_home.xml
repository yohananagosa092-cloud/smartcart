<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl" android:background="@color/sc_bg" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:gravity="center_vertical">
    <TextView android:layout_width="36dp" android:layout_height="48dp" android:gravity="center" android:importantForAccessibility="no" android:textDirection="ltr" android:text="@string/sc_screen_chevron" android:textColor="@color/sc_mint_primary" android:textSize="26sp" />
    <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:textAlignment="viewStart" android:text="@string/app_name" android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline"  />
</LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/sc_line" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical">
                <TextView android:id="@+id/home_avatar" style="@style/Widget.SmartCart.Avatar" android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="yes" android:contentDescription="@string/sc_profile" />
                <TextView android:id="@+id/home_greeting" android:layout_width="match_parent" android:layout_height="wrap_content"  android:fontFamily="@font/rubik_semibold" android:textFontWeight="600" android:textAppearance="@style/TextAppearance.SmartCart.TitleLarge" android:layout_marginStart="18dp" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/home_counts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" style="@style/Widget.SmartCart.Card" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/home_created" android:layout_width="match_parent" android:layout_height="wrap_content"  android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline" android:gravity="center" android:textColor="@color/sc_mint_primary" />
    <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sc_created" android:textAppearance="@style/TextAppearance.SmartCart.Body" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/sc_ink_soft" />
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/home_shared" android:layout_width="match_parent" android:layout_height="wrap_content"  android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline" android:gravity="center" android:textColor="@color/sc_mint_primary" />
    <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sc_shared" android:textAppearance="@style/TextAppearance.SmartCart.Body" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/sc_ink_soft" />
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/home_private" android:layout_width="match_parent" android:layout_height="wrap_content"  android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline" android:gravity="center" android:textColor="@color/sc_mint_primary" />
    <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sc_private" android:textAppearance="@style/TextAppearance.SmartCart.Body" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/sc_ink_soft" />
</LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sc_recent_list" android:fontFamily="@font/rubik_semibold" android:textFontWeight="600" android:textAppearance="@style/TextAppearance.SmartCart.TitleLarge" android:layout_marginTop="26dp" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/btn_to_list_editor" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" style="@style/Widget.SmartCart.Card" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp" android:orientation="vertical">
                    <TextView android:id="@+id/home_recent_name" android:layout_width="match_parent" android:layout_height="wrap_content"  android:fontFamily="@font/rubik_semibold" android:textFontWeight="600" android:textAppearance="@style/TextAppearance.SmartCart.TitleMedium"  />
                    <TextView android:id="@+id/home_recent_detail" android:layout_width="match_parent" android:layout_height="wrap_content"  android:textAppearance="@style/TextAppearance.SmartCart.Body" android:layout_marginTop="8dp" android:textColor="@color/sc_ink_soft" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_to_new_list" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.SmartCart.Button.Primary" android:fontFamily="@font/rubik_semibold" android:textFontWeight="600" android:text="@string/sc_new_action" android:layout_marginTop="39dp" android:minHeight="56dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/home_all_lists" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.SmartCart.Button.Secondary" android:text="@string/sc_all_lists" android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/sc_line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/home_current" android:layout_width="0dp" style="@style/Widget.SmartCart.Button.Secondary" android:text="@string/sc_home" android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:textSize="12sp" /><com.google.android.material.button.MaterialButton android:id="@+id/btn_to_my_lists" android:layout_width="0dp" style="@style/Widget.SmartCart.Button.Secondary" android:textColor="@color/sc_ink_soft" android:text="@string/sc_lists" android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_to_shared_lists" android:layout_width="0dp" style="@style/Widget.SmartCart.Button.Secondary" android:textColor="@color/sc_ink_soft" android:text="@string/sc_shared_tab" android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:textSize="12sp" /><com.google.android.material.button.MaterialButton android:id="@+id/btn_to_profile" android:layout_width="0dp" style="@style/Widget.SmartCart.Button.Secondary" android:textColor="@color/sc_ink_soft" android:text="@string/sc_profile" android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

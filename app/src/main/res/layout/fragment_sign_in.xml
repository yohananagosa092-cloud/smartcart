<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="36dp" android:layout_height="48dp" android:gravity="center" android:importantForAccessibility="no" android:textDirection="ltr" android:text="@string/sc_screen_chevron" android:textColor="@color/sc_mint_primary" android:textSize="28sp" />
            <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_sign_in_title"
            android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline"
            android:gravity="start|center_vertical"
            android:minHeight="72dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/sc_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_brand"
            android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Display"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/sc_mint_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_welcome"
            android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline"
            android:layout_marginTop="26dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_intro"
            android:textAppearance="@style/TextAppearance.SmartCart.Body"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:textColor="@color/sc_ink_soft" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_email"
            android:textAppearance="@style/TextAppearance.SmartCart.Body"
            android:layout_marginTop="16dp"
            android:labelFor="@id/auth_email_value" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_email_field"
            style="@style/Widget.SmartCart.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_email_value"
                style="@style/Widget.SmartCart.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:autofillHints="emailAddress"
                android:hint="@string/auth_email_hint" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_password"
            android:textAppearance="@style/TextAppearance.SmartCart.Body"
            android:layout_marginTop="16dp"
            android:labelFor="@id/auth_password_value" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_password_field"
            style="@style/Widget.SmartCart.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_password_value"
                style="@style/Widget.SmartCart.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:inputType="textPassword"
                android:singleLine="true"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_forgot"
            style="@style/Widget.SmartCart.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_forgot"
            android:gravity="start|center_vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_submit"
            style="@style/Widget.SmartCart.Button.Primary" android:fontFamily="@font/rubik_semibold" android:textFontWeight="600"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_sign_in"
            android:layout_marginTop="22dp"
            android:minHeight="56dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_alternate"
            style="@style/Widget.SmartCart.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_register_link"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>

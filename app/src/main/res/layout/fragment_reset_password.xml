<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/auth_header_back" style="@style/Widget.SmartCart.Button.Secondary" android:layout_width="36dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:textDirection="ltr" android:text="@string/sc_screen_chevron" android:textSize="28sp" android:contentDescription="@string/list_back" />
            <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:minHeight="72dp"
            android:text="@string/auth_reset_title"
            android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/sc_line" />
        <TextView
            android:id="@+id/auth_reset_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/auth_reset_heading"
            android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline" />
        <TextView
            android:id="@+id/auth_reset_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auth_reset_intro"
            android:textAppearance="@style/TextAppearance.SmartCart.Body" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_email"
            android:textAppearance="@style/TextAppearance.SmartCart.Body"
            android:layout_marginTop="56dp"
            android:labelFor="@id/auth_email_value" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_email_field"
            style="@style/Widget.SmartCart.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_email_value"
                style="@style/Widget.SmartCart.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:autofillHints="emailAddress"
                android:hint="@string/auth_email_hint" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_submit"
            style="@style/Widget.SmartCart.Button.Primary" android:fontFamily="@font/rubik_semibold" android:textFontWeight="600"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:minHeight="56dp"
            android:text="@string/auth_reset_send" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_alternate"
            style="@style/Widget.SmartCart.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="@string/auth_reset_back" />
    </LinearLayout>
</ScrollView>

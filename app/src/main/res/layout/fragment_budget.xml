<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl"
    android:background="@color/sc_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/list_back"
                style="@style/Widget.SmartCart.Button.Secondary" android:layout_width="36dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="@string/sc_screen_chevron" android:textDirection="ltr"
                android:textSize="26sp" android:contentDescription="@string/list_back" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SmartCart.Headline" android:text="@string/budget_title" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/sc_line" />
    <TextView android:id="@+id/budget_list_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:textAppearance="@style/TextAppearance.SmartCart.TitleMedium" />
    <TextView android:id="@+id/budget_question" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="40dp" android:textAppearance="@style/TextAppearance.SmartCart.Body" android:text="@string/budget_question" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/budget_input"
        style="@style/Widget.SmartCart.Input" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:hint="@string/budget_amount">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/budget_amount"
            style="@style/Widget.SmartCart.Input.EditText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" android:maxLength="5" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/budget_range" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.SmartCart.Caption" android:text="@string/budget_range" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
        <com.google.android.material.chip.Chip android:id="@+id/budget_150" style="@style/Widget.SmartCart.Chip"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp" android:checkable="false" android:text="@string/budget_150" />
        <com.google.android.material.chip.Chip android:id="@+id/budget_250" style="@style/Widget.SmartCart.Chip"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp" android:checkable="false" android:text="@string/budget_250" />
        <com.google.android.material.chip.Chip android:id="@+id/budget_400" style="@style/Widget.SmartCart.Chip"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp" android:checkable="false" android:text="@string/budget_400" />
        <com.google.android.material.chip.Chip android:id="@+id/budget_600" style="@style/Widget.SmartCart.Chip"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp" android:checkable="false" android:text="@string/budget_600" />
    </LinearLayout>
    <TextView android:id="@+id/budget_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:textAppearance="@style/TextAppearance.SmartCart.TitleMedium" />
    <com.google.android.material.button.MaterialButton android:id="@+id/budget_save"
        style="@style/Widget.SmartCart.Button.Primary" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="64dp" android:text="@string/budget_save" />
    </LinearLayout>
</ScrollView>

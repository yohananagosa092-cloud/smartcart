<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl" android:background="@color/sc_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:gravity="center_vertical">
    <com.google.android.material.button.MaterialButton android:id="@+id/list_back" style="@style/Widget.SmartCart.Button.Secondary" android:layout_width="36dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:textDirection="ltr" android:text="@string/sc_screen_chevron" android:textSize="26sp" android:contentDescription="@string/list_back" />
    <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/list_new_title" android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline"  />
</LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/sc_line" />
        <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sc_new_heading" android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline" android:layout_marginTop="52dp" />
        <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sc_new_subtitle" android:textAppearance="@style/TextAppearance.SmartCart.Body" android:layout_marginTop="18dp" android:textColor="@color/sc_ink_soft" />
        <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/list_name" android:textAppearance="@style/TextAppearance.SmartCart.Body" android:layout_marginTop="58dp" android:labelFor="@id/new_list_name" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Widget.SmartCart.Input"
            app:hintEnabled="false" app:helperText="@string/sc_name_length">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/new_list_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Widget.SmartCart.Input.EditText" android:inputType="textCapSentences"
                android:maxLength="40" android:singleLine="true" android:gravity="start|center_vertical"
                android:hint="@string/sc_weekly_hint" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sc_suggestions" android:fontFamily="@font/rubik_semibold" android:textFontWeight="600" android:textAppearance="@style/TextAppearance.SmartCart.TitleMedium" android:layout_marginTop="36dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
            <com.google.android.material.chip.Chip android:id="@+id/new_monthly" style="@style/Widget.SmartCart.Chip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:checkable="false" android:gravity="center" android:text="@string/sc_monthly" app:chipMinHeight="36dp" />
<com.google.android.material.chip.Chip android:id="@+id/new_weekend" style="@style/Widget.SmartCart.Chip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:checkable="false" android:gravity="center" android:text="@string/sc_weekend" app:chipMinHeight="36dp" />
<com.google.android.material.chip.Chip android:id="@+id/new_passover" style="@style/Widget.SmartCart.Chip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:checkable="false" android:gravity="center" android:text="@string/sc_passover" app:chipMinHeight="36dp" />
<com.google.android.material.chip.Chip android:id="@+id/new_hosting" style="@style/Widget.SmartCart.Chip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:checkable="false" android:gravity="center" android:text="@string/sc_hosting" app:chipMinHeight="36dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/new_list_create" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.SmartCart.Button.Primary" android:fontFamily="@font/rubik_semibold" android:textFontWeight="600" android:text="@string/list_new" android:layout_marginTop="68dp" android:minHeight="56dp" />
    </LinearLayout>
</ScrollView>

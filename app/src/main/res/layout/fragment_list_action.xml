<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl"
    android:background="@color/sc_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/list_back"
                style="@style/Widget.SmartCart.Button.Secondary" android:layout_width="36dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="@string/sc_screen_chevron" android:textDirection="ltr"
                android:textSize="26sp" android:contentDescription="@string/list_back" />
            <TextView android:id="@+id/list_action_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SmartCart.Headline" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/sc_line" />
        <TextView android:id="@+id/list_action_heading" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="128dp" android:visibility="gone"
            android:textAppearance="@style/TextAppearance.SmartCart.Headline" />
        <TextView android:id="@+id/list_action_warning" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="48dp" android:visibility="gone"
            android:textAppearance="@style/TextAppearance.SmartCart.Body" android:textColor="@color/sc_warn_coral"
            android:text="@string/list_delete_warning" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/list_action_name_layout"
            style="@style/Widget.SmartCart.Input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="92dp" android:visibility="gone"
            android:hint="@string/list_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/list_action_name"
                style="@style/Widget.SmartCart.Input.EditText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapSentences"
                android:maxLength="40" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/list_action_confirm"
            style="@style/Widget.SmartCart.Button.Primary" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="76dp" android:enabled="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/list_action_cancel"
            style="@style/Widget.SmartCart.Button.Secondary" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="8dp" android:text="@string/sc_cancel"
            android:backgroundTint="@color/sc_surface"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

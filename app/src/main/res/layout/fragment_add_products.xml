<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:background="@color/sc_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="72dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/list_back" style="@style/Widget.SmartCart.Button.Secondary" android:layout_width="36dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:textDirection="ltr" android:text="@string/sc_screen_chevron" android:textSize="28sp" android:contentDescription="@string/list_back" />
        <TextView android:id="@+id/list_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/list_add_title"
        android:fontFamily="@font/rubik_bold" android:textFontWeight="700" android:textAppearance="@style/TextAppearance.SmartCart.Headline"  />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/sc_line" />
    <LinearLayout android:id="@+id/product_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/product_query" android:text="@string/list_search"
            android:textAppearance="@style/TextAppearance.SmartCart.Body" />
        <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        style="@style/Widget.SmartCart.Input" app:hintEnabled="false">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/product_query"
            android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.SmartCart.Input.EditText"
            android:gravity="start|center_vertical" android:inputType="text" android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout><TextView android:id="@+id/product_search_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/list_search_help"
        android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.SmartCart.Caption"
        android:textColor="@color/sc_ink_faint" />
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout android:id="@+id/product_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp"
        android:background="@color/sc_bg" app:tabBackground="@drawable/sc_product_tab"
        app:tabIndicator="@null" app:tabIndicatorHeight="0dp"
        app:tabTextAppearance="@style/TextAppearance.SmartCart.Caption"
        app:tabTextColor="@color/sc_ink_soft" app:tabSelectedTextColor="@color/sc_on_accent">
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/list_search_tab" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/list_free_tab" />
    </com.google.android.material.tabs.TabLayout>
    <LinearLayout android:id="@+id/product_free" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.SmartCart.Input" android:hint="@string/list_free_name">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/product_free_name"
            android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.SmartCart.Input.EditText" android:inputType="text" android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.SmartCart.Input"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:hint="@string/list_free_quantity">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/product_free_quantity"
                style="@style/Widget.SmartCart.Input.EditText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="number" android:maxLength="3" android:text="@string/list_default_quantity" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.SmartCart.Input"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:hint="@string/list_free_note">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/product_free_note"
                style="@style/Widget.SmartCart.Input.EditText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/product_free_help" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="40dp" android:text="@string/list_free_help" android:textColor="@color/sc_ink_soft"
            android:textAppearance="@style/TextAppearance.SmartCart.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/product_free_add" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="44dp"
            style="@style/Widget.SmartCart.Button.Primary" android:text="@string/list_add_to_list" />
    </LinearLayout>
    <TextView android:id="@+id/product_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/list_loading"
        android:textAppearance="@style/TextAppearance.SmartCart.Body" android:visibility="gone" />
    <TextView android:id="@+id/product_empty_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:visibility="gone" android:text="@string/list_empty_detail"
        android:textColor="@color/sc_ink_soft" android:textAppearance="@style/TextAppearance.SmartCart.Body" />
    <LinearLayout android:id="@+id/product_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" >

    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/product_fallback" android:layout_width="match_parent" android:layout_height="wrap_content"
        style="@style/Widget.SmartCart.Button.Primary" android:text="@string/list_free_fallback"
        android:layout_marginTop="28dp" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/product_done" android:layout_width="match_parent" android:layout_height="wrap_content"
        style="@style/Widget.SmartCart.Button.Secondary" android:text="@string/list_done" android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/sc_bg" android:fillViewport="true" android:layoutDirection="rtl">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:id="@+id/sc_preview_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SmartCart.Headline" android:text="@string/sc_preview_title" android:layout_marginBottom="16dp" />
<com.google.android.material.button.MaterialButton style="@style/Widget.SmartCart.Button.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sc_primary" />
<com.google.android.material.button.MaterialButton style="@style/Widget.SmartCart.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sc_secondary" />
<com.google.android.material.card.MaterialCardView style="@style/Widget.SmartCart.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/sc_card_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SmartCart.TitleMedium" android:text="@string/sc_card_title" android:layout_marginBottom="16dp" /><TextView android:id="@+id/sc_card_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SmartCart.Caption" android:text="@string/sc_card_subtitle" android:layout_marginBottom="16dp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.smartcart.app.ui.components.QuantitySelectorView android:id="@+id/sc_preview_quantity" android:layout_width="wrap_content" android:layout_height="wrap_content" />
<com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true"><com.google.android.material.chip.Chip android:id="@+id/sc_chip_all" style="@style/Widget.SmartCart.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:checked="true" android:text="@string/sc_chip_all" /><com.google.android.material.chip.Chip android:id="@+id/sc_chip_dairy" style="@style/Widget.SmartCart.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:checked="false" android:text="@string/sc_chip_dairy" /></com.google.android.material.chip.ChipGroup>
<TextView style="@style/Widget.SmartCart.Avatar" android:layout_width="28dp" android:layout_height="28dp" android:text="@string/sc_initials" />
<TextView style="@style/Widget.SmartCart.Status.Success" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/sc_status_success" />
<TextView style="@style/Widget.SmartCart.Status.Accent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/sc_status_accent" />
<TextView style="@style/Widget.SmartCart.Status.Warning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/sc_status_warning" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/sc_list_name" android:text="@string/sc_input_label" android:textAppearance="@style/TextAppearance.SmartCart.Body" />
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"><com.google.android.material.textfield.TextInputLayout style="@style/Widget.SmartCart.Input" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintHorizontal_bias="0" app:layout_constraintWidth_max="488dp" app:hintEnabled="false"><com.google.android.material.textfield.TextInputEditText android:id="@+id/sc_list_name" style="@style/Widget.SmartCart.Input.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/sc_input_hint" android:inputType="textCapSentences" android:maxLength="40" /></com.google.android.material.textfield.TextInputLayout></androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout></ScrollView>

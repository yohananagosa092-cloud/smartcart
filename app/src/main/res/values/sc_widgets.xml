<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.SmartCart.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/rubik_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sc_button_text</item>
        <item name="backgroundTint">@color/sc_button_background</item>
        <item name="cornerRadius">@dimen/sc_button_radius</item>
        <item name="android:minHeight">@dimen/sc_touch_target</item>
    </style>
    <style name="Widget.SmartCart.Button.Secondary" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/rubik_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sc_mint_primary</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">@dimen/sc_button_radius</item>
        <item name="android:minHeight">@dimen/sc_touch_target</item>
    </style>
    <style name="Widget.SmartCart.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/sc_surface</item>
        <item name="cardCornerRadius">@dimen/sc_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/sc_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/sc_card_padding</item>
    </style>
    <style name="Widget.SmartCart.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/sc_chip_text</item>
        <item name="chipBackgroundColor">@color/sc_chip_background</item>
        <item name="chipStrokeColor">@color/sc_line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipMinTouchTargetSize">48dp</item>
    </style>
    <style name="Widget.SmartCart.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/sc_surface</item>
        <item name="boxStrokeColor">@color/sc_input_stroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/sc_ink_soft</item>
    </style>
    <style name="Widget.SmartCart.Input.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/sc_ink</item>
        <item name="android:textColorHint">@color/sc_ink_faint</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="Widget.SmartCart.QuantityButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/rubik_semibold</item>
        <item name="android:textColor">@color/sc_mint_primary</item>
        <item name="backgroundTint">@color/sc_mint_soft</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="Widget.SmartCart.Avatar" parent="">
        <item name="android:fontFamily">@font/rubik_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/sc_mint_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/sc_avatar</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.SmartCart.Status.Success" parent="">
        <item name="android:fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/sc_mint_primary</item>
        <item name="android:background">@drawable/sc_status_mint</item>
    </style>
    <style name="Widget.SmartCart.Status.Accent" parent="">
        <item name="android:fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/sc_sun_accent</item>
        <item name="android:background">@drawable/sc_status_sun</item>
    </style>
    <style name="Widget.SmartCart.Status.Warning" parent="">
        <item name="android:fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/sc_on_accent</item>
        <item name="android:background">@drawable/sc_status_warn</item>
    </style>
</resources>
